#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || {
  echo "This installer must be run through pkexec." >&2
  exit 1
}

list="${1:-}"
[ -n "$list" ] || exit 2
case "$list" in
  *[!a-z0-9,+.-]*)
    echo "Invalid package list." >&2
    exit 2
    ;;
esac

old_ifs="$IFS"
IFS=','
set -- $list
IFS="$old_ifs"

# Strict allow-list: no arbitrary package names can be passed to this helper.
for pkg in "$@"; do
  case "$pkg" in
    firmware-iwlwifi|firmware-realtek|firmware-atheros|firmware-brcm80211|firmware-mediatek|firmware-libertas|firmware-amd-graphics|firmware-intel-graphics|firmware-nvidia-graphics|firmware-intel-sound) ;;
    *) echo "Package not allowed: $pkg" >&2; exit 2 ;;
  esac
done

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends "$@"
